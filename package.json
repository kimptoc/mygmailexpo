{
  "name": "expo-template-default",
  "license": "0BSD",
  "main": "expo-router/entry",
  "version": "54.0.35",
  "homepage": "https://kimptoc.github.io/mygmailexpo",
  "scripts": {
    "gen:icons": "node ./scripts/generate-icons.js",
    "build:info": "node ./scripts/generate-build-info.js",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npm run build:info && expo run:android",
    "ios": "npm run build:info && expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "draft": "npx eas-cli@latest workflow:run create-draft.yml",
    "development-builds": "npx eas-cli@latest workflow:run create-development-builds.yml",
    "deploy": "npx eas-cli@latest workflow:run deploy-to-production.yml",
    "build:web": "WEB_BUILD=1 npm run build:info && WEB_BUILD=1 expo export --platform web --clear",
    "deploy:web": "npm run build:web && node ./scripts/deploy-web.js",
    "serve:local": "WEB_BUILD=1 npm run build:web && touch dist/.nojekyll && rm -rf /tmp/serve-test && mkdir -p /tmp/serve-test/mygmailexpo && cp -r dist/* /tmp/serve-test/mygmailexpo/ && npx serve /tmp/serve-test",
    "test": "jest --config jest.config.node.js",
    "eas-build-post-install": "npm run build:info"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-auth-session": "^7.0.10",
    "expo-constants": "~18.0.9",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "canvas": "^2.11.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "gh-pages": "^6.3.0",
    "jest": "^30.2.0",
    "jest-expo": "^54.0.17",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  }
}
